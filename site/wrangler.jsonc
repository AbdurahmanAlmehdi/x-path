// xpath.abdurahman.ly: static assets only, no Worker script and no build step.
// Deployed by Cloudflare Workers Builds (root directory `site`, deploy command
// `npx wrangler deploy`); see "Website" in docs/reference/development.md.
{
  "name": "x-path",
  "compatibility_date": "2026-05-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "xpath.abdurahman.ly", "custom_domain": true }
  ],
  "workers_dev": false,
  // Pull requests get their own preview link (Workers Builds runs
  // `npx wrangler preview` on non-production branches).
  "preview_urls": true,
  "previews": {}
}
